# 豆芽成长助手：免费内测环境变量模板
#
# 复制为 .env.staging 后再填写真实值：
#   Copy-Item .env.staging.example .env.staging
# .env.staging 已被 .gitignore 忽略，禁止提交到 Git。

# Compose 数据库初始化参数。只在第一次创建 MySQL 数据卷时生效。
MYSQL_ROOT_PASSWORD=change-this-root-password
MYSQL_APP_PASSWORD=change-this-app-password
REDIS_PASSWORD=change-this-redis-password

# 容器网络内的 MySQL 主机名必须是 mysql，不是 127.0.0.1。
TUOGUAN_SYSTEM_DATABASE_DSN=tuoguan_app:change-this-app-password@tcp(mysql:3306)/tuoguan_system?parseTime=true&charset=utf8mb4&collation=utf8mb4_unicode_ci&loc=UTC

# 至少 32 个字符，建议使用只包含字母和数字的随机值，避免 Compose 特殊字符转义。
TUOGUAN_SYSTEM_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
TUOGUAN_SYSTEM_STORAGE_URL_SIGNING_SECRET=replace-with-a-second-random-secret-at-least-32-chars

# 内测首次启动时可以临时保留 true，创建账号后改为 false。
TUOGUAN_SYSTEM_AUTH_BOOTSTRAP_ADMIN_ENABLED=true
TUOGUAN_SYSTEM_AUTH_BOOTSTRAP_ADMIN_USERNAME=admin
TUOGUAN_SYSTEM_AUTH_BOOTSTRAP_ADMIN_PASSWORD=replace-with-admin-password
TUOGUAN_SYSTEM_AUTH_BOOTSTRAP_PLATFORM_ADMIN_ENABLED=true
TUOGUAN_SYSTEM_AUTH_BOOTSTRAP_PLATFORM_ADMIN_USERNAME=platform
TUOGUAN_SYSTEM_AUTH_BOOTSTRAP_PLATFORM_ADMIN_PASSWORD=replace-with-platform-password

# 未准备好微信配置时保持 false；准备好后改为 true 并补全下面的值。
TUOGUAN_SYSTEM_WECHAT_ENABLED=false
TUOGUAN_SYSTEM_WECHAT_APP_ID=
TUOGUAN_SYSTEM_WECHAT_APP_SECRET=
TUOGUAN_SYSTEM_WECHAT_SUBSCRIBE_TEMPLATES_PICKUP=
TUOGUAN_SYSTEM_WECHAT_SUBSCRIBE_TEMPLATES_MEAL=
TUOGUAN_SYSTEM_WECHAT_SUBSCRIBE_TEMPLATES_HOMEWORK=
TUOGUAN_SYSTEM_WECHAT_SUBSCRIBE_TEMPLATES_LEAVE=
TUOGUAN_SYSTEM_WECHAT_SUBSCRIBE_TEMPLATES_SUMMARY=

# 免费内测不启用短信、云 OCR 和 OSS。
TUOGUAN_SYSTEM_SMS_ENABLED=false
TUOGUAN_SYSTEM_OCR_ENABLED=false
