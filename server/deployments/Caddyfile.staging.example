# 免费内测 HTTPS 示例。将 xy.pdurl.cn 的 DNS A 记录指向服务器，
# 并确保服务器 80/443 端口放行，Caddy 会自动申请和续期 Let's Encrypt 证书。

xy.pdurl.cn {
    encode zstd gzip
    reverse_proxy 127.0.0.1:8080
}

# 管理端建议使用独立子域名。确认 DNS 已配置后，再取消下面注释，
# 并将静态构建产物复制到 /srv/douya-admin。
# admin.xy.pdurl.cn {
#     encode zstd gzip
#     root * /srv/douya-admin
#     try_files {path} /index.html
#     file_server
# }
