TUOGUAN_SYSTEM_APP_NAME=tuoguan-system
TUOGUAN_SYSTEM_APP_ENV=local
TUOGUAN_SYSTEM_HTTP_ADDR=:8080
TUOGUAN_SYSTEM_LOG_LEVEL=info

# 至少 32 个字符；生产环境必须替换为随机高强度密钥
TUOGUAN_SYSTEM_AUTH_SECRET=tuoguan-system-local-auth-secret-change-me-2026
TUOGUAN_SYSTEM_AUTH_ACCESS_TTL=2h
TUOGUAN_SYSTEM_AUTH_REFRESH_TTL=720h
# 仅本地初始化使用；生产环境必须设为 false
TUOGUAN_SYSTEM_AUTH_BOOTSTRAP_ADMIN_ENABLED=true
TUOGUAN_SYSTEM_AUTH_BOOTSTRAP_ADMIN_USERNAME=admin
TUOGUAN_SYSTEM_AUTH_BOOTSTRAP_ADMIN_PASSWORD=123456

TUOGUAN_SYSTEM_WECHAT_ENABLED=false
TUOGUAN_SYSTEM_WECHAT_APP_ID=
TUOGUAN_SYSTEM_WECHAT_APP_SECRET=
TUOGUAN_SYSTEM_WECHAT_ENDPOINT=https://api.weixin.qq.com/sns/jscode2session
TUOGUAN_SYSTEM_WECHAT_TIMEOUT=5s
TUOGUAN_SYSTEM_WECHAT_SUBSCRIBE_TEMPLATE_ID=
TUOGUAN_SYSTEM_WECHAT_SUBSCRIBE_PAGE=pages/parent/index
TUOGUAN_SYSTEM_WECHAT_SUBSCRIBE_TEMPLATES_PICKUP=
TUOGUAN_SYSTEM_WECHAT_SUBSCRIBE_TEMPLATES_MEAL=
TUOGUAN_SYSTEM_WECHAT_SUBSCRIBE_TEMPLATES_HOMEWORK=
TUOGUAN_SYSTEM_WECHAT_SUBSCRIBE_TEMPLATES_LEAVE=
TUOGUAN_SYSTEM_WECHAT_SUBSCRIBE_TEMPLATES_SUMMARY=
# 模板字段映射请在 YAML 配置中的 wechat.subscribe_template_fields 设置

TUOGUAN_SYSTEM_STORAGE_PROVIDER=local
TUOGUAN_SYSTEM_STORAGE_UPLOAD_DIR=data/uploads
# 留空时复用 TUOGUAN_SYSTEM_AUTH_SECRET；生产环境建议单独设置随机高强度密钥
TUOGUAN_SYSTEM_STORAGE_URL_SIGNING_SECRET=
TUOGUAN_SYSTEM_STORAGE_ENDPOINT=
TUOGUAN_SYSTEM_STORAGE_BUCKET=
TUOGUAN_SYSTEM_STORAGE_REGION=us-east-1
TUOGUAN_SYSTEM_STORAGE_ACCESS_KEY=
TUOGUAN_SYSTEM_STORAGE_SECRET_KEY=
TUOGUAN_SYSTEM_STORAGE_PATH_STYLE=true
TUOGUAN_SYSTEM_STORAGE_SIGNED_URL_TTL=15m
TUOGUAN_SYSTEM_STORAGE_MAX_FILE_BYTES=5242880
TUOGUAN_SYSTEM_STORAGE_RETENTION_DAYS=90

TUOGUAN_SYSTEM_DATABASE_ENABLED=false
TUOGUAN_SYSTEM_DATABASE_DRIVER=mysql
TUOGUAN_SYSTEM_DATABASE_DSN=tuoguan_system:tuoguan_system_pass@tcp(127.0.0.1:3306)/tuoguan_system
TUOGUAN_SYSTEM_DATABASE_MAX_OPEN_CONNS=25
TUOGUAN_SYSTEM_DATABASE_MAX_IDLE_CONNS=5
TUOGUAN_SYSTEM_DATABASE_CONN_MAX_LIFETIME=30m
TUOGUAN_SYSTEM_DATABASE_CONN_MAX_IDLE_TIME=5m
TUOGUAN_SYSTEM_DATABASE_PING_TIMEOUT=3s

TUOGUAN_SYSTEM_REDIS_ENABLED=false
TUOGUAN_SYSTEM_REDIS_ADDR=127.0.0.1:6379
TUOGUAN_SYSTEM_REDIS_USERNAME=
TUOGUAN_SYSTEM_REDIS_PASSWORD=
TUOGUAN_SYSTEM_REDIS_DB=0
TUOGUAN_SYSTEM_REDIS_DIAL_TIMEOUT=3s
TUOGUAN_SYSTEM_REDIS_READ_TIMEOUT=2s
TUOGUAN_SYSTEM_REDIS_WRITE_TIMEOUT=2s
TUOGUAN_SYSTEM_REDIS_PING_TIMEOUT=2s
TUOGUAN_SYSTEM_REDIS_POOL_SIZE=10
TUOGUAN_SYSTEM_REDIS_MIN_IDLE_CONNS=2
TUOGUAN_SYSTEM_REDIS_KEY_PREFIX=tuoguan-system:local

TUOGUAN_SYSTEM_WORKER_ENABLED=false
TUOGUAN_SYSTEM_WORKER_CONCURRENCY=10
TUOGUAN_SYSTEM_WORKER_SHUTDOWN_TIMEOUT=10s
TUOGUAN_SYSTEM_WORKER_NOTIFICATION_POLL_INTERVAL=2s
TUOGUAN_SYSTEM_WORKER_NOTIFICATION_LEASE=30s
TUOGUAN_SYSTEM_WORKER_NOTIFICATION_MAX_ATTEMPTS=3

TUOGUAN_SYSTEM_OBSERVABILITY_METRICS_ENABLED=true
TUOGUAN_SYSTEM_OBSERVABILITY_METRICS_PATH=/metrics
TUOGUAN_SYSTEM_OBSERVABILITY_METRICS_NAMESPACE=tuoguan_system
TUOGUAN_SYSTEM_OBSERVABILITY_TRACING_ENABLED=false
TUOGUAN_SYSTEM_OBSERVABILITY_TRACING_EXPORTER=stdout
TUOGUAN_SYSTEM_OBSERVABILITY_TRACING_ENDPOINT=localhost:4317
TUOGUAN_SYSTEM_OBSERVABILITY_TRACING_INSECURE=true
TUOGUAN_SYSTEM_OBSERVABILITY_TRACING_SAMPLE_RATIO=1.0
