# Application identity
VITE_APP_TITLE=豆芽成长助手
VITE_APP_NAMESPACE=tuoguan-admin
VITE_APP_STORE_SECURE_KEY=tuoguan-admin-change-this-key

# Development server
VITE_PORT=5173
VITE_BASE=/
VITE_GLOB_API_URL=/api
# Go 业务 API 通过 Vite 代理访问，避免本地开发端口变化导致 CORS 错误
VITE_TUOGUAN_API_URL=/tuoguan-api/api/v1
VITE_TUOGUAN_PROXY_TARGET=http://localhost:8081
VITE_NITRO_MOCK=true
VITE_DEVTOOLS=false
VITE_INJECT_APP_LOADING=true
