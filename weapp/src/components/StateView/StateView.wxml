<view class="state-view state-view--{{type}}">
  <view wx:if="{{type === 'loading'}}" class="state-view__spinner"></view>
  <view class="state-view__title">{{title}}</view>
  <view wx:if="{{description}}" class="state-view__description">{{description}}</view>
  <t-button wx:if="{{actionText}}" class="state-view__action" size="small" theme="primary" bind:tap="handleAction">
    {{actionText}}
  </t-button>
</view>
