<view class="page add-child-page">
  <view class="apply-top-actions">
    <view class="apply-home-button" bind:tap="handleBackToIdentity">⌂</view>
    <view class="apply-refresh-button" bind:tap="handleRefresh">{{loading ? '刷新中…' : '刷新状态'}}</view>
  </view>

  <view class="apply-hero">
    <view class="apply-hero-copy">
      <view class="apply-kicker">豆芽成长助手</view>
      <view class="apply-title">添加孩子</view>
      <view class="apply-subtitle">{{hasBoundChild ? '已绑定孩子，可以继续添加其他孩子。' : '先提交入班申请，老师审核通过并绑定孩子后，才能进入家长端首页。'}}</view>
    </view>
    <view class="apply-hero-mark">
      <view class="apply-hero-leaf"></view>
      芽
    </view>
  </view>

  <view wx:if="{{hasBoundChild}}" class="apply-success-card">
    <view class="apply-success-icon">✓</view>
    <view class="apply-success-copy">
      <view class="apply-success-title">已有孩子绑定成功</view>
      <view class="apply-success-text">可以进入家长端查看接送、作业、餐食和每日总结。</view>
    </view>
    <t-button size="small" theme="primary" bind:tap="handleEnterParent">进入家长端</t-button>
  </view>

  <view wx:else class="apply-guard-card">
    <view class="apply-guard-icon">i</view>
    <view>
      <view class="apply-guard-title">绑定成功前暂不能进入家长端</view>
      <view class="apply-guard-text">这是为了避免未授权账号看到孩子接送照片和托管记录。</view>
    </view>
  </view>

  <view class="apply-stepper">
    <view class="apply-step apply-step-current">
      <view class="apply-step-number">1</view>
      <view>填写资料</view>
    </view>
    <view class="apply-step-line"></view>
    <view class="apply-step">
      <view class="apply-step-number">2</view>
      <view>提交申请</view>
    </view>
    <view class="apply-step-line"></view>
    <view class="apply-step">
      <view class="apply-step-number">3</view>
      <view>老师审核</view>
    </view>
    <view class="apply-step-line"></view>
    <view class="apply-step">
      <view class="apply-step-number">4</view>
      <view>绑定成功</view>
    </view>
  </view>

  <view class="form-card add-child-card">
    <view class="section-head">
      <view>
        <view class="section-kicker">{{editingApplicationID ? '补充资料' : '入班申请'}}</view>
        <view class="section-title">{{editingApplicationID ? '修改孩子资料' : '填写孩子资料'}}</view>
      </view>
      <view class="section-note">提交后由老师审核</view>
    </view>
    <view class="muted-text intro-copy">只需要填写孩子姓名、年级、家长手机号和备注；学校、班级、托管班由老师审核时分配。</view>

    <view wx:if="{{invitedSchoolClassID}}" class="success-note">
      <view class="success-note-icon">✓</view>
      <view>已通过老师邀请链接进入，学校和班级信息已带入。</view>
    </view>

    <view class="form-field">
      <text class="field-label">孩子姓名</text>
      <view class="field-control">
        <input class="field-input" maxlength="64" placeholder="{{focusedField === 'childName' ? '' : '请输入孩子姓名'}}" data-field="childName" value="{{childName}}" bindinput="handleInput" bindfocus="handleFocus" bindblur="handleBlur" />
      </view>
    </view>

    <block wx:if="{{!invitedSchoolClassID}}">
      <view class="form-field">
        <text class="field-label">孩子年级</text>
        <view class="field-control">
          <input class="field-input" maxlength="32" placeholder="{{focusedField === 'classText' ? '' : '例如：一年级'}}" data-field="classText" value="{{classText}}" bindinput="handleInput" bindfocus="handleFocus" bindblur="handleBlur" />
        </view>
      </view>
    </block>

    <view class="form-field">
      <text class="field-label">家长手机号</text>
      <view class="field-control">
        <input class="field-input" type="number" disabled maxlength="32" placeholder="{{focusedField === 'guardianPhone' ? '' : '登录手机号会自动带入'}}" data-field="guardianPhone" value="{{guardianPhone}}" bindinput="handleInput" bindfocus="handleFocus" bindblur="handleBlur" />
      </view>
    </view>

    <view wx:if="{{editingApplicationID}}" class="warning-note form-note">这是补充资料，提交后会回到老师审核队列。</view>

    <view class="form-field">
      <text class="field-label">补充说明（可选）</text>
      <textarea class="field-textarea" maxlength="500" placeholder="{{focusedField === 'applicationNotes' ? '' : '如有特殊情况可在这里说明'}}" data-field="applicationNotes" value="{{applicationNotes}}" bindinput="handleInput" bindfocus="handleFocus" bindblur="handleBlur" />
    </view>

    <view class="form-submit">
      <t-button block theme="primary" loading="{{loading}}" bind:tap="handleSubmitApplication">{{editingApplicationID ? '重新提交审核' : '提交入班申请'}}</t-button>
    </view>
  </view>

  <view class="content-card application-record-card">
    <view class="section-head">
      <view>
        <view class="section-kicker">申请进度</view>
        <view class="section-title">我的申请记录</view>
      </view>
      <view class="section-note">{{applications.length ? applications.length + ' 条' : '暂无记录'}}</view>
    </view>

    <block wx:if="{{applications.length}}">
      <view wx:for="{{applications}}" wx:key="id" class="record-row">
        <view class="record-main">
          <view class="record-title-line">
            <text class="record-title">{{item.student_name}}</text>
            <text class="status-pill {{item.status === 'needs_info' ? 'status-tone-warning' : item.status === 'rejected' ? 'status-tone-danger' : item.status === 'approved' ? 'status-tone-success' : ''}}">{{item.status_label}}</text>
          </view>
          <view class="record-meta">{{item.school_name_input ? item.school_name_input + ' · ' : ''}}{{item.grade_input || item.grade || '年级待确认'}}{{item.class_name_input}}</view>
          <view wx:if="{{item.review_note}}" class="record-note">老师备注：{{item.review_note}}</view>
          <view wx:if="{{item.status === 'pending'}}" class="record-tip">老师审核通过后，孩子会自动绑定到当前账号。</view>
          <view wx:if="{{item.status === 'needs_info'}}" class="record-action">
            <t-button size="small" variant="outline" data-application-id="{{item.id}}" bind:tap="handleResubmitApplication">修改并重提</t-button>
          </view>
        </view>
      </view>
    </block>

    <view wx:else class="apply-empty-state">
      <view class="apply-empty-icon">芽</view>
      <view class="apply-empty-title">还没有提交申请</view>
      <view class="apply-empty-text">填写上方资料后，老师会在管理端审核。</view>
    </view>
  </view>

  <view class="privacy-note">
    <view class="privacy-lock">●</view>
    孩子信息仅对审核通过后的授权账号可见
  </view>

  <t-toast id="t-toast" />
</view>
