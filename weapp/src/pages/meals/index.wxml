<view class="page meals-page">
  <view class="page-header"><view class="page-header__identity"><view class="brand-emblem">芽</view><view><view class="page-eyebrow">星芽托管助手 · 教师端</view><view class="page-title">餐食管理</view><view class="page-subtitle">提前告诉家长明天吃什么，也记录孩子实际吃到的餐食</view></view></view><view class="page-helper">{{loading ? '同步中…' : '餐食历史可追溯'}}</view></view>
  <view class="meals-toolbar"><view><text class="field-label">查看日期</text><picker mode="date" value="{{date}}" bindchange="handleDateChange"><view class="picker-input">{{date}}<text class="picker-arrow">⌄</text></view></picker></view><view class="meal-actions"><t-button size="small" variant="outline" loading="{{submitting}}" bind:tap="copyHistory">复制历史</t-button><t-button size="small" theme="primary" bind:tap="openEditor">{{plans.length ? '编辑餐食' : '录入餐食'}}</t-button></view></view>
  <view class="content-card week-menu-card"><view class="section-head"><view><view class="section-kicker">周菜单</view><view class="section-title">本周餐食安排</view></view><view class="section-note">点击日期编辑</view></view><view wx:for="{{weekMenu}}" wx:key="meal_date" class="week-menu-row {{item.recorded ? '' : 'week-menu-row-empty'}}" data-date="{{item.meal_date}}" bind:tap="handleWeekMenuSelect"><view class="week-menu-date"><view class="week-menu-weekday">{{item.weekday_label}}</view><view class="week-menu-date-text">{{item.meal_date}}</view></view><view class="week-menu-content"><view wx:if="{{item.recorded}}" class="week-menu-text">{{item.menu_text}}</view><view wx:else class="week-menu-text week-menu-text-empty">待录入</view><view wx:if="{{item.adjustment_note}}" class="week-menu-note">调整：{{item.adjustment_note}}</view></view><image wx:if="{{item.photo_url_signed}}" class="week-menu-photo" mode="aspectFill" src="{{item.photo_url_signed}}" /></view></view>
  <view wx:if="{{plans.length}}" class="content-card meal-card"><view class="section-head"><view><view class="section-kicker">{{plans[0].meal_date}}</view><view class="section-title">今日餐食安排</view></view><view class="status-pill status-tone-success">已登记</view></view><view class="menu-text">{{plans[0].menu_text}}</view><image wx:if="{{plans[0].photo_url_signed}}" class="meal-photo" mode="aspectFill" src="{{plans[0].photo_url_signed}}" /><view wx:if="{{plans[0].adjustment_note}}" class="warning-note">临时调整：{{plans[0].adjustment_note}}</view><view class="record-meta">记录人：{{plans[0].created_by_name || '老师'}} · 更新于 {{plans[0].updated_at}}</view></view>
  <view wx:else class="empty-state soft-card"><view class="empty-illustration">食</view><t-empty description="当天还没有餐食安排" /><t-button theme="primary" bind:tap="openEditor">录入餐食</t-button></view>
  <view class="content-card meal-history-card"><view class="section-head"><view><view class="section-kicker">餐食记录</view><view class="section-title">近 7 天历史</view></view><view class="section-note">{{historyPlans.length}} 天</view></view><block wx:if="{{historyPlans.length}}"><view wx:for="{{historyPlans}}" wx:key="id" class="meal-history-row"><view class="meal-history-date">{{item.meal_date}}</view><view class="meal-history-menu">{{item.menu_text}}</view><view wx:if="{{item.adjustment_note}}" class="record-note">调整：{{item.adjustment_note}}</view><image wx:if="{{item.photo_url_signed}}" class="meal-history-photo" mode="aspectFill" src="{{item.photo_url_signed}}" /></view></block><view wx:else class="parent-inline-empty"><view>还没有餐食历史</view></view></view>
  <view class="content-card diet-alert-card"><view class="section-head"><view><view class="section-kicker">安全照护</view><view class="section-title">今日需关注的饮食备注</view></view><view class="section-note">{{dietNotes.length}} 位学生</view></view><block wx:if="{{dietNotes.length}}"><view wx:for="{{dietNotes}}" wx:key="student_id" class="diet-alert-row"><view class="diet-alert-name">{{item.student_name}}</view><view class="diet-alert-note">{{item.note}}</view></view></block><view wx:else class="parent-inline-empty"><view>今天暂无饮食备注</view><text>如家长补充过敏信息，会显示在这里</text></view></view>
  <view class="content-card diet-request-card"><view class="section-head"><view><view class="section-kicker">家长提交</view><view class="section-title">待确认的饮食变更</view></view><view class="section-note">{{dietNoteRequests.length}} 条待处理</view></view><view class="muted-text intro-copy">家长提交的过敏和特殊饮食变更需要老师确认，通过后才会替换正式备注。</view><block wx:if="{{dietNoteRequests.length}}"><view wx:for="{{dietNoteRequests}}" wx:key="id" class="diet-request-row"><view class="diet-request-name">{{item.student_name}}</view><view class="diet-request-current">原备注：{{item.current_note || '暂无'}}</view><view class="diet-request-new">申请改为：{{item.requested_note || '清除备注'}}</view><view class="diet-request-actions"><t-button size="small" theme="primary" data-request-id="{{item.id}}" data-status="approved" bind:tap="reviewDietNoteRequest">确认生效</t-button><t-button size="small" variant="outline" data-request-id="{{item.id}}" data-status="rejected" bind:tap="reviewDietNoteRequest">驳回</t-button></view></view></block><view wx:else class="parent-inline-empty"><view>暂无待确认申请</view><text>家长提交后会出现在这里</text></view></view>
  <t-popup visible="{{showEditor}}" placement="bottom" bind:visible-change="closeEditor"><view class="meal-sheet"><view class="sheet-handle"></view><view class="sheet-header"><view><view class="section-kicker">餐食记录</view><view class="section-title">{{date}} 菜单</view></view><view class="text-link" bind:tap="closeEditor">取消</view></view><view class="sheet-field"><text class="field-label">菜单内容</text><textarea class="field-textarea" maxlength="2000" placeholder="例如：番茄炒蛋、清炒时蔬、紫菜蛋花汤" data-field="menuText" value="{{menuText}}" bindinput="handleInput" bindfocus="handleFocus" bindblur="handleBlur" /></view><view class="sheet-field"><text class="field-label">实际餐食照片（可选）</text><t-button size="small" variant="outline" loading="{{submitting}}" bind:tap="choosePhoto">{{photoURL ? '重新上传' : '上传照片'}}</t-button><image wx:if="{{photoPreviewURL}}" class="meal-photo preview" mode="aspectFill" src="{{photoPreviewURL}}" /></view><view class="sheet-field"><text class="field-label">临时调整说明（可选）</text><textarea class="field-textarea" maxlength="500" placeholder="如有临时换菜、延迟用餐等情况请说明" data-field="adjustmentNote" value="{{adjustmentNote}}" bindinput="handleInput" bindfocus="handleFocus" bindblur="handleBlur" /></view><view class="sheet-submit"><t-button block theme="primary" loading="{{submitting}}" bind:tap="submit">保存并通知家长</t-button></view></view></t-popup>
  <t-toast id="t-toast" />
</view>
