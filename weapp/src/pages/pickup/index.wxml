<view class="page pickup-page">
  <view class="page-header pickup-header">
    <view class="page-header__identity"><view class="brand-emblem">芽</view><view><view class="page-eyebrow">豆芽成长助手 · 教师端</view><view class="page-title">教师今日工作台</view><view class="page-subtitle">先看待办，再按现场状态逐人完成确认</view></view></view>
    <view class="page-helper">{{loading ? '任务同步中…' : date}}</view>
  </view>

  <view class="pickup-summary-card">
    <view class="summary-date"><view class="summary-date-label">今日接送进度</view><view class="summary-date-value">{{handledStudentCount}} / {{totals.students}} 人已处理</view><view class="summary-date-caption">{{totals.tasks}} 个班级任务 · {{overallProgress}}% 完成</view></view>
    <view class="summary-divider"></view>
    <view class="summary-stat"><view class="summary-stat-number">{{totals.planned}}</view><view class="summary-stat-label">待确认</view></view>
    <view class="summary-stat summary-stat-alert"><view class="summary-stat-number">{{todoItems.length}}</view><view class="summary-stat-label">待办事项</view></view>
  </view>
  <view class="overall-progress-card"><view class="overall-progress-track"><view class="overall-progress-value" style="{{overallProgressStyle}}"></view></view><view class="overall-progress-footer"><text>接送记录会实时同步给家长</text><text>{{totals.pending_photo}} 张照片待补</text></view></view>

  <view class="header-actions"><t-button size="small" variant="outline" bind:tap="handleOpenExceptions">异常中心</t-button><t-button wx:if="{{assignments.length}}" size="small" variant="outline" bind:tap="handleShareParentInvite">邀请家长</t-button><t-button wx:if="{{assignments.length}}" size="small" theme="primary" bind:tap="handleCreateTodayTask">新建接送任务</t-button></view>

  <view wx:if="{{todoItems.length}}" class="todo-card soft-card"><view class="todo-card-header"><view><view class="section-kicker">今日工作台</view><view class="todo-card-title">按这个顺序处理更稳妥</view></view><view class="todo-count">{{todoItems.length}} 项</view></view><view wx:for="{{todoItems}}" wx:key="key" class="todo-item"><view class="todo-item-marker {{item.kind}}"></view><view class="todo-item-copy"><view class="todo-item-title">{{item.title}}</view><view class="todo-item-message">{{item.message}}</view></view></view></view>

  <view wx:if="{{alerts.length}}" class="warning-note alert-card"><view class="alert-title"><view class="alert-icon">!</view><view>今日待处理</view></view><view wx:for="{{alerts}}" wx:key="message" class="alert-item">{{item.message}}</view></view>

  <view wx:if="{{changeRequests.length}}" class="warning-note alert-card change-request-card"><view class="alert-title"><view class="alert-icon">变</view><view>家长临时接送变更</view></view><view wx:for="{{changeRequests}}" wx:key="id" class="change-request-item"><view class="change-request-main"><view class="change-request-title">{{item.student_name}} · {{item.change_date}} · {{item.requested_status_label}}</view><view class="change-request-note">{{item.note}}</view><view class="change-request-meta">提交人：{{item.submitted_by || '家长'}}</view></view><view class="change-request-actions"><t-button size="small" theme="success" data-request-id="{{item.id}}" data-status="approved" bind:tap="handleReviewChangeRequest">同意</t-button><t-button size="small" variant="outline" data-request-id="{{item.id}}" data-status="rejected" bind:tap="handleReviewChangeRequest">拒绝</t-button></view></view></view>

  <view wx:if="{{leaveRequests.length}}" class="warning-note alert-card leave-review-card"><view class="alert-title"><view class="alert-icon">假</view><view>今日请假待处理</view></view><view wx:for="{{leaveRequests}}" wx:key="id" class="change-request-item"><view class="change-request-main"><view class="change-request-title">{{item.student_name || ('学生 #' + item.student_id)}} · {{item.class_name || '班级待同步'}}</view><view class="change-request-note">{{item.reason}}</view><view class="change-request-meta">{{item.submitted_by_type === 'teacher' ? '老师代记' : '家长提交'}} · {{item.leave_date}}</view></view><view class="change-request-actions"><t-button size="small" theme="success" data-request-id="{{item.id}}" data-status="approved" bind:tap="handleReviewLeaveRequest">同意</t-button><t-button size="small" variant="outline" data-request-id="{{item.id}}" data-status="rejected" bind:tap="handleReviewLeaveRequest">拒绝</t-button></view></view></view>

  <block wx:if="{{operations.length}}">
    <view wx:for="{{operations}}" wx:key="id" class="pickup-task-card">
      <view class="task-card-header"><view class="task-heading"><view class="section-kicker">接送任务 · {{item.class_label}}</view><view class="task-title">{{item.class_label}}</view><view class="task-meta">执行老师：{{item.executing_teacher_name || item.teacher_name || '未指定'}} · {{item.expected_pickup_time || '出发时间待确认'}}<text wx:if="{{item.expected_pickup_time}}"> 出发</text> · {{item.students.length}} 名学生</view></view><view class="status-pill {{item.status}}">{{item.status_label}}</view></view>
      <view class="task-progress"><view class="task-progress-dot {{item.overdue ? 'task-progress-dot-overdue' : ''}}"></view><view class="task-progress-text">{{item.overdue ? '已超过预计出发时间，请优先核对现场进度' : item.status === 'started' ? '接送流程进行中，请逐人完成确认' : item.status === 'finished' ? '本次任务已完成' : '完成准备后即可开始接送'}}</view></view>
      <checkbox-group class="student-list" data-operation-id="{{item.id}}" bindchange="handleBulkSelectionChange">
        <view wx:for="{{item.students}}" wx:for-item="student" wx:key="student_id" class="student-row">
          <view class="student-top"><view class="student-identity"><checkbox wx:if="{{student.can_bulk_arrive}}" class="student-checkbox" value="{{student.student_id}}" checked="{{student.selected_for_bulk}}"></checkbox><view wx:else class="student-checkbox-placeholder"></view><view class="student-avatar">{{student.student_name}}</view><view class="student-copy"><view class="student-name">{{student.student_name}}<text wx:if="{{student.is_temporary}}" class="temporary-tag">临时</text></view><view class="student-meta">{{student.checked_display}}<text wx:if="{{student.photo_status}}"> · {{student.photo_status}}</text><text wx:if="{{student.profile_pending}}"> · 档案待补</text></view></view></view><view wx:if="{{student.status !== 'planned'}}" class="status-pill student-status {{student.status === 'abnormal' || student.status === 'not_arrived' ? 'status-tone-danger' : student.status === 'leave' ? 'status-tone-warning' : student.status === 'absent' ? 'status-tone-muted' : student.status === 'arrived' || student.status === 'left' ? 'status-tone-success' : ''}}">{{student.status_label}}</view></view>
          <view wx:if="{{student.profile_pending}}" class="student-profile-action"><t-button size="small" variant="outline" data-operation-id="{{item.id}}" data-student-id="{{student.student_id}}" bind:tap="handleCompleteProfile">补充档案</t-button></view>
          <view wx:if="{{item.status === 'started' && student.status !== 'planned'}}" class="student-correction-action"><t-button size="small" variant="outline" data-operation-id="{{item.id}}" data-student-id="{{student.student_id}}" bind:tap="handleCorrectStatus">更正记录</t-button></view>
          <view wx:if="{{item.status === 'started' && student.status === 'picked_up'}}" class="student-actions"><t-button size="small" theme="success" data-operation-id="{{item.id}}" data-student-id="{{student.student_id}}" data-status="arrived" bind:tap="handleMark">到班</t-button><t-button size="small" variant="outline" data-operation-id="{{item.id}}" data-student-id="{{student.student_id}}" bind:tap="handleStudentMoreActions">更多</t-button></view>
          <view wx:if="{{item.status === 'started' && (student.status === 'arrived' || student.status === 'self_arrived')}}" class="student-actions"><t-button size="small" theme="success" data-operation-id="{{item.id}}" data-student-id="{{student.student_id}}" data-status="left" bind:tap="handleMark">已离班</t-button><t-button size="small" variant="outline" data-operation-id="{{item.id}}" data-student-id="{{student.student_id}}" bind:tap="handleStudentMoreActions">更多</t-button></view>
          <view wx:if="{{item.status === 'started' && student.status === 'planned'}}" class="student-actions"><t-button size="small" theme="primary" data-operation-id="{{item.id}}" data-student-id="{{student.student_id}}" bind:tap="handlePhotoCheckIn">拍照接到</t-button><t-button size="small" variant="outline" data-operation-id="{{item.id}}" data-student-id="{{student.student_id}}" bind:tap="handleStudentMoreActions">更多</t-button></view>
        </view>
      </checkbox-group>
      <view wx:if="{{item.status === 'started' && item.bulk_arrival_count}}" class="bulk-arrive-bar"><view class="bulk-arrive-copy"><view class="bulk-arrive-title">批量到班</view><view class="bulk-arrive-text">已选 {{item.selected_arrival_count}} / {{item.bulk_arrival_count}} 名</view></view><view class="bulk-arrive-actions"><t-button size="small" variant="outline" data-operation-id="{{item.id}}" bind:tap="handleSelectAllArrive">{{item.all_arrival_selected ? '取消全选' : '全选可到班'}}</t-button><t-button size="small" theme="success" disabled="{{!item.selected_arrival_count}}" data-operation-id="{{item.id}}" bind:tap="handleBulkArrive">批量到班</t-button></view></view>
      <view wx:if="{{item.status !== 'finished' && item.status !== 'cancelled'}}" class="task-footer"><view class="task-footer-main"><t-button wx:if="{{item.status === 'draft'}}" size="small" theme="primary" data-operation-id="{{item.id}}" bind:tap="handleConfirm">确认今日名单</t-button><t-button wx:if="{{item.status === 'confirmed'}}" size="small" theme="primary" data-operation-id="{{item.id}}" bind:tap="handleStart">确认出发</t-button><t-button wx:if="{{item.status === 'started'}}" size="small" theme="success" data-operation-id="{{item.id}}" bind:tap="handleFinish">完成接送</t-button></view><view wx:if="{{item.status === 'confirmed' || item.status === 'started'}}" class="task-footer-more"><t-button size="small" variant="outline" data-operation-id="{{item.id}}" bind:tap="handleTaskMoreActions">更多</t-button></view></view>
    </view>
  </block>
  <view wx:else class="empty-state soft-card"><view class="empty-illustration">芽</view><t-empty description="{{assignments.length ? '今天还没有接送任务' : '暂未配置可操作的学校班级'}}" /><t-button wx:if="{{assignments.length}}" theme="primary" block bind:tap="handleCreateTodayTask">创建今日任务</t-button></view>
  <t-toast id="t-toast" />
</view>
