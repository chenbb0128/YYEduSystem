<view class="page pickup-page">
  <view class="page-header pickup-header">
    <view class="page-header__identity"><view class="brand-emblem">芽</view><view><view class="page-eyebrow">星芽托管助手 · 教师端</view><view class="page-title">今日接送</view><view class="page-subtitle">把每一次接到、到班和离班，都记录得清清楚楚</view></view></view>
    <view class="page-helper">{{loading ? '任务同步中…' : date}}</view>
  </view>

  <view class="pickup-summary-card">
    <view class="summary-date"><view class="summary-date-label">今天的接送安排</view><view class="summary-date-value">{{date}}</view></view>
    <view class="summary-divider"></view>
    <view class="summary-stat"><view class="summary-stat-number">{{operations.length}}</view><view class="summary-stat-label">进行中任务</view></view>
    <view class="summary-stat summary-stat-alert"><view class="summary-stat-number">{{alerts.length}}</view><view class="summary-stat-label">待处理提醒</view></view>
  </view>

  <view class="header-actions"><t-button wx:if="{{assignments.length}}" size="small" variant="outline" bind:tap="handleShareParentInvite">邀请家长</t-button><t-button wx:if="{{assignments.length}}" size="small" theme="primary" bind:tap="handleCreateTodayTask">创建今日任务</t-button></view>

  <view wx:if="{{alerts.length}}" class="warning-note alert-card"><view class="alert-title"><view class="alert-icon">!</view><view>今日待处理</view></view><view wx:for="{{alerts}}" wx:key="message" class="alert-item">{{item.message}}</view></view>

  <view wx:if="{{changeRequests.length}}" class="warning-note alert-card change-request-card"><view class="alert-title"><view class="alert-icon">变</view><view>家长临时接送变更</view></view><view wx:for="{{changeRequests}}" wx:key="id" class="change-request-item"><view class="change-request-main"><view class="change-request-title">{{item.student_name}} · {{item.change_date}} · {{item.requested_status_label}}</view><view class="change-request-note">{{item.note}}</view><view class="change-request-meta">提交人：{{item.submitted_by || '家长'}}</view></view><view class="change-request-actions"><t-button size="small" theme="success" data-request-id="{{item.id}}" data-status="approved" bind:tap="handleReviewChangeRequest">同意</t-button><t-button size="small" variant="outline" data-request-id="{{item.id}}" data-status="rejected" bind:tap="handleReviewChangeRequest">拒绝</t-button></view></view></view>

  <block wx:if="{{operations.length}}">
    <view wx:for="{{operations}}" wx:key="id" class="pickup-task-card">
      <view class="task-card-header"><view class="task-heading"><view class="section-kicker">接送任务 · 学校班级 #{{item.school_class_id}}</view><view class="task-title">{{item.executing_teacher_name || item.teacher_name || '未指定老师'}}</view><view class="task-meta">{{item.expected_pickup_time || '出发时间待确认'}}<text wx:if="{{item.expected_pickup_time}}"> 出发</text> · {{item.students.length}} 名学生</view></view><view class="status-pill {{item.status}}">{{item.status_label}}</view></view>
      <view class="task-progress"><view class="task-progress-dot {{item.overdue ? 'task-progress-dot-overdue' : ''}}"></view><view class="task-progress-text">{{item.overdue ? '已超过预计出发时间，请优先核对现场进度' : item.status === 'started' ? '接送流程进行中，请逐人完成确认' : item.status === 'finished' ? '本次任务已完成' : '完成准备后即可开始接送'}}</view></view>
      <view class="student-list">
        <view wx:for="{{item.students}}" wx:for-item="student" wx:key="student_id" class="student-row">
          <view class="student-top"><view class="student-identity"><view class="student-avatar">{{student.student_name}}</view><view class="student-copy"><view class="student-name">{{student.student_name}}<text wx:if="{{student.is_temporary}}" class="temporary-tag">临时</text></view><view class="student-meta">{{student.checked_display}}<text wx:if="{{student.profile_pending}}"> · 档案待补</text></view></view></view><view wx:if="{{student.status !== 'planned'}}" class="status-pill student-status {{student.status === 'abnormal' || student.status === 'not_arrived' ? 'status-tone-danger' : student.status === 'leave' ? 'status-tone-warning' : student.status === 'absent' ? 'status-tone-muted' : student.status === 'arrived' || student.status === 'left' ? 'status-tone-success' : ''}}">{{student.status_label}}</view></view>
          <view wx:if="{{student.profile_pending}}" class="student-profile-action"><t-button size="small" variant="outline" data-operation-id="{{item.id}}" data-student-id="{{student.student_id}}" bind:tap="handleCompleteProfile">补充档案</t-button></view>
          <view wx:if="{{item.status === 'started' && student.status !== 'planned'}}" class="student-correction-action"><t-button size="small" variant="outline" data-operation-id="{{item.id}}" data-student-id="{{student.student_id}}" bind:tap="handleCorrectStatus">更正记录</t-button></view>
          <view wx:if="{{item.status === 'started' && student.status === 'picked_up'}}" class="student-actions"><t-button wx:if="{{!student.photo_url}}" size="small" theme="primary" data-operation-id="{{item.id}}" data-student-id="{{student.student_id}}" bind:tap="handlePhotoCheckIn">补传照片</t-button><t-button size="small" theme="success" data-operation-id="{{item.id}}" data-student-id="{{student.student_id}}" data-status="arrived" bind:tap="handleMark">到班</t-button><t-button size="small" variant="outline" data-operation-id="{{item.id}}" data-student-id="{{student.student_id}}" data-status="not_arrived" bind:tap="handleMark">未到班</t-button><t-button size="small" variant="outline" data-operation-id="{{item.id}}" data-student-id="{{student.student_id}}" data-status="abnormal" bind:tap="handleMark">异常</t-button></view>
          <view wx:if="{{item.status === 'started' && (student.status === 'arrived' || student.status === 'self_arrived')}}" class="student-actions"><t-button size="small" theme="success" data-operation-id="{{item.id}}" data-student-id="{{student.student_id}}" data-status="left" bind:tap="handleMark">已离班</t-button><t-button size="small" variant="outline" data-operation-id="{{item.id}}" data-student-id="{{student.student_id}}" data-status="midway_left" bind:tap="handleMark">中途离班</t-button><t-button size="small" variant="outline" data-operation-id="{{item.id}}" data-student-id="{{student.student_id}}" data-status="abnormal" bind:tap="handleMark">异常</t-button></view>
          <view wx:if="{{item.status === 'started' && student.status === 'planned'}}" class="student-actions"><t-button size="small" theme="primary" data-operation-id="{{item.id}}" data-student-id="{{student.student_id}}" bind:tap="handlePhotoCheckIn">拍照接到</t-button><t-button size="small" variant="outline" data-operation-id="{{item.id}}" data-student-id="{{student.student_id}}" data-status="self_arrived" bind:tap="handleMark">自行到班</t-button><t-button size="small" variant="outline" data-operation-id="{{item.id}}" data-student-id="{{student.student_id}}" data-status="parent_picked_up" bind:tap="handleMark">家长接走</t-button><t-button size="small" variant="outline" data-operation-id="{{item.id}}" data-student-id="{{student.student_id}}" data-status="leave" bind:tap="handleMark">请假</t-button><t-button size="small" variant="outline" data-operation-id="{{item.id}}" data-student-id="{{student.student_id}}" data-status="absent" bind:tap="handleMark">未找到</t-button></view>
        </view>
      </view>
      <view class="task-footer"><t-button wx:if="{{item.status === 'draft'}}" size="small" theme="primary" data-operation-id="{{item.id}}" bind:tap="handleConfirm">确认今日任务</t-button><t-button wx:if="{{item.status === 'confirmed'}}" size="small" theme="primary" data-operation-id="{{item.id}}" bind:tap="handleStart">确认出发</t-button><t-button wx:if="{{item.status === 'confirmed' || item.status === 'started'}}" size="small" variant="outline" data-operation-id="{{item.id}}" bind:tap="handleAddTemporaryStudent">临时加学生</t-button><t-button wx:if="{{item.status === 'started'}}" size="small" variant="outline" data-operation-id="{{item.id}}" bind:tap="handleHandover">途中交接</t-button><t-button wx:if="{{item.status === 'started'}}" size="small" variant="outline" data-operation-id="{{item.id}}" bind:tap="handleViewHandoffs">交接记录</t-button><t-button wx:if="{{item.status === 'started'}}" size="small" theme="success" data-operation-id="{{item.id}}" bind:tap="handleFinish">完成任务</t-button></view>
    </view>
  </block>
  <view wx:else class="empty-state soft-card"><view class="empty-illustration">芽</view><t-empty description="{{assignments.length ? '今天还没有接送任务' : '暂未配置可操作的学校班级'}}" /><t-button wx:if="{{assignments.length}}" theme="primary" block bind:tap="handleCreateTodayTask">创建今日任务</t-button></view>
  <t-toast id="t-toast" />
</view>
