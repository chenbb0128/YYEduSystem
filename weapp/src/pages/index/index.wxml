<AppPage>
  <view class="page home-page" style="{{topSafeStyle}}">
    <block wx:if="{{!authenticated || role === 'parent'}}">
      <view class="brand-hero">
        <view class="brand-row">
          <view class="brand-emblem">芽</view>
          <view class="home-brand-copy">
            <view class="page-eyebrow">{{appName}}</view>
            <view class="page-title">豆芽成长助手</view>
            <view class="page-subtitle">安心托管，成长可见</view>
          </view>
          <view class="search-register-chip" bindtap="handleParentLogin"><view class="search-dot"></view>家长入口</view>
        </view>
      </view>

      <view class="welcome-card login-welcome-card">
        <view class="welcome-copy welcome-copy-centered">
          <view class="welcome-overline">欢迎进入</view>
          <view class="welcome-title">豆芽成长助手</view>
          <view class="welcome-text">家长使用微信登录，教师和管理员使用手机号密码登录</view>
        </view>
        <view class="mascot" aria-label="豆芽精灵">
          <view class="mascot-glow"></view>
          <view class="mascot-wing mascot-wing-left"></view>
          <view class="mascot-wing mascot-wing-right"></view>
          <view class="mascot-body"><view class="mascot-heart"></view></view>
          <view class="mascot-head">
            <view class="mascot-leaf mascot-leaf-left"></view>
            <view class="mascot-leaf mascot-leaf-right"></view>
            <view class="mascot-eye mascot-eye-left"></view>
            <view class="mascot-eye mascot-eye-right"></view>
            <view class="mascot-cheek mascot-cheek-left"></view>
            <view class="mascot-cheek mascot-cheek-right"></view>
            <view class="mascot-mouth"></view>
          </view>
          <view class="mascot-star mascot-star-one">✦</view>
          <view class="mascot-star mascot-star-two">✧</view>
          <view class="mascot-star mascot-star-three">✦</view>
          <view class="mascot-cloud"></view>
        </view>
      </view>

      <block wx:if="{{loginMode === 'choose'}}">
        <view class="phone-auth-card">
          <view class="phone-auth-top">
            <view class="phone-auth-icon">芽</view>
            <view class="phone-auth-copy">
              <view class="phone-auth-title">请选择登录方式</view>
              <view class="phone-auth-text">家长使用微信授权，教师和管理员使用手机号密码登录。</view>
            </view>
          </view>
          <button class="wechat-auth-button" disabled="{{parentLoginLoading}}" hover-class="phone-auth-button-active" bindtap="handleParentLogin">{{parentLoginLoading ? '正在微信登录…' : '家长微信登录'}}</button>
          <view class="wechat-auth-divider"><view class="wechat-auth-divider-line"></view><text>教师和管理员</text><view class="wechat-auth-divider-line"></view></view>
          <button class="phone-auth-button" hover-class="phone-auth-button-active" bindtap="handleOpenTeacherLogin">教师 / 管理员登录</button>
          <view class="phone-auth-safe">
            <view class="phone-auth-safe-dot"></view>
            家长首次进入后可提交孩子入班申请；教师和管理员账号由管理端创建
          </view>
        </view>
      </block>

      <block wx:elif="{{loginMode === 'teacher'}}">
        <view class="form-card login-form-card">
          <view class="section-head"><view><view class="section-kicker">教师工作台</view><view class="section-title">登录你的工作账号</view></view><view class="text-link" bindtap="handleBackToLoginChoice">返回入口</view></view>
          <view class="form-intro">登录后可以查看接送名单、批改作业并审核家长入班申请。</view>
          <view class="form-field"><text class="field-label">手机号</text><view class="field-control"><input class="field-input" type="number" maxlength="32" placeholder="{{focusedField === 'phoneNumber' ? '' : '请输入后台登记的手机号'}}" data-field="phoneNumber" value="{{phoneNumber}}" bindinput="handleInput" bindfocus="handleFocus" bindblur="handleBlur" /></view></view>
          <view class="form-field"><text class="field-label">密码</text><view class="field-control"><input class="field-input" password placeholder="{{focusedField === 'password' ? '' : '请输入密码'}}" data-field="password" value="{{password}}" bindinput="handleInput" bindfocus="handleFocus" bindblur="handleBlur" /></view></view>
          <view class="login-submit"><t-button block theme="primary" loading="{{loginLoading}}" bindtap="handleTeacherLogin">登录工作台</t-button></view>
          <view class="form-footnote">手机号和密码由管理端创建或设置；家长请使用微信登录。</view>
        </view>
      </block>

      <view class="privacy-note"><view class="privacy-lock">●</view>接送照片和孩子信息仅对授权账号可见</view>
    </block>

    <block wx:elif="{{role === 'teacher'}}">
      <view class="page-header home-header">
        <view class="page-header__identity">
          <view class="brand-emblem">芽</view>
          <view class="home-brand-copy">
            <view class="page-eyebrow">{{appName}}</view>
            <view class="page-title">教师工作台</view>
            <view class="page-subtitle">把今天要做的事安排清楚</view>
          </view>
        </view>
        <view class="service-chip {{initialized ? 'service-chip-ready' : ''}}"><view class="service-dot"></view>{{initialized ? '服务正常' : '初始化中'}}</view>
      </view>

      <view class="role-hero role-hero-teacher">
        <view class="role-hero-top"><view class="role-hero-icon">师</view><view class="role-hero-action" bindtap="handleLogout">退出登录</view></view>
        <view class="role-hero-title">教师工作台</view>
        <view class="role-hero-text">把今天要做的事安排清楚，孩子的每一次到达都值得被认真记录。</view>
        <view class="role-hero-tip">{{hasStarted ? '工作台已打开，祝今天顺利！' : '准备开始今天的工作'}}</view>
      </view>

      <view class="section-head dashboard-heading"><view><view class="section-kicker">机构概览</view><view class="section-title">今日工作底盘</view></view><view class="section-note">{{summaryLoading ? '数据同步中' : '实时数据'}}</view></view>
      <view class="stat-grid">
        <view class="stat-card stat-card-green"><view class="stat-icon">学</view><view class="stat-number">{{summary ? summary.students : '--'}}</view><view class="stat-label">学生档案</view></view>
        <view class="stat-card stat-card-blue"><view class="stat-icon">校</view><view class="stat-number">{{summary ? summary.schools : '--'}}</view><view class="stat-label">学校</view></view>
        <view class="stat-card stat-card-yellow"><view class="stat-icon">班</view><view class="stat-number">{{summary ? summary.school_classes : '--'}}</view><view class="stat-label">学校班级</view></view>
        <view class="stat-card stat-card-purple"><view class="stat-icon">托</view><view class="stat-number">{{summary ? summary.care_classes : '--'}}</view><view class="stat-label">托管班</view></view>
      </view>

      <view class="soft-card work-entry-card">
        <view class="section-head"><view><view class="section-kicker">快捷入口</view><view class="section-title">今天要做什么</view></view><view class="section-note">5 项工作</view></view>
        <view class="work-entry-list">
          <view class="action-card action-card-pickup" bindtap="handleOpenPickup"><view class="action-icon">今</view><view class="action-copy"><view class="action-title">今日工作台</view><view class="action-text">接送点名、到班确认和收班提醒</view></view><view class="action-arrow">›</view></view>
          <view class="action-card action-card-homework" bindtap="handleOpenHomework"><view class="action-icon">作</view><view class="action-copy"><view class="action-title">作业管理</view><view class="action-text">布置作业、逐人批改反馈</view></view><view class="action-arrow">›</view></view>
          <view class="action-card action-card-application" bindtap="handleOpenApplications"><view class="action-icon">申</view><view class="action-copy"><view class="action-title">家长申请</view><view class="action-text">审核入班，自动建立绑定</view></view><view class="action-arrow">›</view></view>
          <view class="action-card action-card-homework" bindtap="handleOpenMeals"><view class="action-icon">食</view><view class="action-copy"><view class="action-title">餐食管理</view><view class="action-text">录入菜单、上传实际餐食照片</view></view><view class="action-arrow">›</view></view>
      <view class="action-card action-card-application" bindtap="handleOpenSummary"><view class="action-icon">结</view><view class="action-copy"><view class="action-title">每日总结</view><view class="action-text">生成、编辑并发布当天托管总结</view></view><view class="action-arrow">›</view></view>
      <view class="action-card action-card-application" bindtap="handleOpenExceptions"><view class="action-icon">异</view><view class="action-copy"><view class="action-title">异常中心</view><view class="action-text">集中处理接送、作业和请假待办</view></view><view class="action-arrow">›</view></view>
        </view>
      </view>
    </block>

  </view>
  <t-toast id="t-toast" />
</AppPage>
