# Copy to .env.local, or generate it with `pnpm init:project`.
# VITE_* values are bundled into client code. Never put secrets here.
VITE_APP_NAME=星芽托管助手
VITE_STORAGE_PREFIX=weapp-template
VITE_API_BASE_URL=https://api.example.com
VITE_API_TIMEOUT=10000
VITE_ENABLE_LOG=true
VITE_WECHAT_SUBSCRIBE_PICKUP_TEMPLATE_ID=
VITE_WECHAT_SUBSCRIBE_MEAL_TEMPLATE_ID=
VITE_WECHAT_SUBSCRIBE_HOMEWORK_TEMPLATE_ID=
VITE_WECHAT_SUBSCRIBE_LEAVE_TEMPLATE_ID=
VITE_WECHAT_SUBSCRIBE_SUMMARY_TEMPLATE_ID=
